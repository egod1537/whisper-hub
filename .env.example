# Copy to .env, then set API_KEY to a strong random value (for example: openssl rand -hex 32).
API_KEY=
API_HOST=0.0.0.0
API_PORT=3000
DATA_DIR=/data
DB_PATH=/data/whisper-hub.sqlite
WHISPER_BASE_URL=http://host.docker.internal:8080
MAX_UPLOAD_BYTES=262144000
MAX_DURATION_SECONDS=7200
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=1
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
WHISPER_TIMEOUT_MS=7200000
DEFAULT_MODEL=base
COMPLETED_RETENTION_DAYS=7
FAILED_RETENTION_DAYS=3
SOURCE_RETENTION_DAYS=1
# Leave empty to keep CORS disabled. Comma-separate exact origins when needed.
CORS_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=info

